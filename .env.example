# Objektfrei – Zugangsdaten. Diese Datei NIEMALS in ein Repository geben.
# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Wird in die Traefik-Labels eingesetzt. www.<DOMAIN> wird auf <DOMAIN> umgeleitet.
# Das Zertifikat holt Traefik über seinen Resolver `letsencrypt`; hier ist dafür
# nichts einzutragen.
DOMAIN=objektfrei.de

# Google Workspace: unter myaccount.google.com/apppasswords ein App-Passwort erzeugen.
# Das normale Kontopasswort funktioniert nicht.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anfrage@objektfrei.de
SMTP_PASS=hier-das-app-passwort

MAIL_FROM=anfrage@objektfrei.de
MAIL_TO=anfrage@objektfrei.de

# Beliebige zufällige Zeichenfolge – anonymisiert die IP-Adressen im Rate-Limit
RATE_SALT=bitte-hier-etwas-zufaelliges-eintragen

# Nur setzen, wenn der clamav-Dienst aktiviert wurde:
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
